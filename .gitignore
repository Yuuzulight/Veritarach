.env
.venv/
__pycache__/
*.pyc
.pytest_cache/
data/raw/
data/generated/
data/model/*
*.ckpt
*.safetensors
.DS_Store

# the checkpoint itself stays out of git (740MB, regenerable), but the metrics
# that came out of training it are small and are exactly what needs to survive --
# otherwise there's no way afterward to check a deployed checkpoint against what
# training actually reported. (un-ignoring a file this deep needs every
# intermediate directory un-ignored too, not just the file itself.)
!data/model/final
data/model/final/*
!data/model/final/test_metrics.json
!data/model/final/training_log.json

# Terraform -- state files and the pre-import droplet snapshot are a sensitive-data
# risk independent of whether they happen to contain the DO token directly. tfvars and
# tfplan files are included defensively too, even though neither exists yet -- a future
# terraform.tfvars or a `plan -out=file` output are exactly the kind of files someone
# could accidentally commit with real values in them.
infra/terraform/droplet-snapshot.json
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/.terraform/
infra/terraform/*.tfvars
infra/terraform/*.tfvars.json
infra/terraform/*.tfplan
infra/terraform/crash.log
infra/terraform/override.tf
infra/terraform/override.tf.json
